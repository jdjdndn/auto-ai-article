{
  "name": "ai-article-pipeline",
  "version": "0.1.0",
  "description": "AI 自动文章生成管线 — 从素材到发布的完整流程，支持任意数据库后端",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "sync-vendor": "npm run build && node sync-vendor.cjs"
  },
  "keywords": [
    "ai",
    "article",
    "pipeline",
    "content-generation",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "cloudflare-workers": "^0.0.14",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3"
  }
}
