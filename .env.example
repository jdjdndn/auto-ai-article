# ============================================================
# ai-article-pipeline 环境变量模板
# 复制为 .env 并填入实际值 | 标 [必填] 的至少配一个 AI 提供方
# ============================================================

# ---------- AI 提供方（至少配一个，否则启动报错） ----------

# OpenRouter 免费模型兜底（CF Workers AI 额度用尽后自动切换）
# 获取：https://openrouter.ai/  [推荐，免费额度大]
OPENROUTER_API_KEY=

# 阿里百炼（通义千问，OpenAI 兼容）
# 获取：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=

# Google Gemini（OpenAI 兼容端点）
# 获取：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral
# 获取：https://console.mistral.ai/
MISTRAL_API_KEY=

# Cerebras（高速推理）
# 获取：https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# 自定义 OpenAI 兼容端点
# LLM_API_KEY=
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_MODEL=your-model

# ---------- Cloudflare（定时调度 + Workers AI 用） ----------

# CF 账号（部署 wrangler / 调用 Workers AI 需要）
# CLOUDFLARE_ACCOUNT_ID=
# CF API Token（需 Workers AI + D1 + DO 权限）
# CLOUDFLARE_API_TOKEN=

# ---------- 云端 AI（本地网关离线时兜底） ----------

# AI_API_KEY=
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# 注：AI_API_BASE / AI_MODEL 仅 CLI 参数生效，设置环境变量不会读取

# ---------- 本地 AI 网关（可选，离线优先用本地） ----------

# 网关地址（默认 http://localhost:3456/v1）
# LOCAL_GATEWAY_URL=http://localhost:3456/v1
# 本地模型（默认 deepseek-chat）
# LOCAL_MODEL=deepseek-chat
# 注：LOCAL_MODEL 仅 CLI 参数生效，设置环境变量不会读取

# ---------- 告警（可选，成功率低于阈值时通知） ----------

# 支持飞书/钉钉/通用 HTTP POST
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 成功率阈值，低于此值触发告警（0~1，默认 0.6）
# ALERT_MIN_SUCCESS_RATE=0.6
